{
  "name": "smart-notes",
  "version": "1.1.2",
  "description": "A desktop note-taking app built with Electron, Vite, and React.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"npm --prefix client run dev\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build:client": "npm --prefix client run build",
    "start": "npm run build:client && electron .",
    "pack": "npm run build:client && electron-builder --win --dir",
    "dist": "npm run build:client && electron-builder --win --publish never",
    "release": "npm run build:client && electron-builder --win --publish always"
  },
  "keywords": [],
  "author": "TheDataDave",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "express": "^5.3.0"
  },
  "build": {
    "appId": "com.smartnotes.app",
    "productName": "Smart Notes",
    "files": [
      "electron/**",
      "server/**",
      "client/dist/**",
      "icons/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "TheDataDave",
        "repo": "smart-notes",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
